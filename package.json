{
  "name": "towniesbarbershop.com",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "bootstrap": "^5.3.8",
    "concurrently": "^10.0.3",
    "sass": "^1.101.0"
  },
  "scripts": {
    "css": "sass --no-source-map --load-path=node_modules/bootstrap/scss _css/townies.scss css/townies.css",
    "css:watch": "npm run css -- --watch",
    "build": "npm run css && eleventy",
    "build:prod": "JEKYLL_ENV=production npm run build",
    "serve": "npm run css && concurrently --kill-others --names css,11ty \"npm run css:watch\" \"eleventy --serve\"",
    "start": "npm run serve",
    "htmlProofer": "bundle exec htmlproofer --disable-external ./_site",
    "test": "npm run htmlProofer"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/townies-barbershop/towniesbarbershop.github.io.git"
  },
  "author": "",
  "homepage": "https://www.towniesbarbershop.com"
}
